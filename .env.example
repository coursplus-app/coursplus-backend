# Copier en .env (jamais commité) et remplir. Voir README.
SPRING_PROFILES_ACTIVE=prod
# openssl rand -base64 48
JWT_SECRET=
DB_URL=jdbc:postgresql://localhost:5432/coursplus
DB_USER=coursplus
DB_PASSWORD=
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8081
# Stockage des vidéos et PDF : local (disque, par défaut) ou s3 (Cloudflare R2, Backblaze B2, MinIO...)
# Sur un hébergeur gratuit (Render...) le disque est effacé à chaque redémarrage : utiliser s3.
STORAGE_TYPE=local
STORAGE_DIR=./uploads
# Seulement si STORAGE_TYPE=s3 (bucket privé) :
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SEED_DATA=false
KONNECT_BASE_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=
MANUAL_PAYMENT_INSTRUCTIONS=
